# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://docintel:docintel@mysql:3306/docintel

# --- Vector DB (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=document_chunks

# --- Embedding provider ---
# Options: local | openai | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM provider ---
# Options: openai | gemini | anthropic | local
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.0-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- RAG config ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RERANKING_ENABLED=false

# --- Object Storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=docintel
S3_SECRET_KEY=docintel123
S3_BUCKET_NAME=documents
S3_REGION=us-east-1
